{
	"name": "markdown-to-html",
	"displayName": "Markdown to HTML",
	"description": "A dead simple extension for VSCode that allows to convert Markdown to HTML using markdown-it.",
	"version": "1.2.0",
	"publisher": "fmoronzirfas",
	"repository": {
		"type": "git",
		"url": "https://github.com/ff6347/markdown-to-html-extension"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:markdown"
	],
	"icon": "icon.png",
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "markdown-to-html.convertToHtml",
				"title": "Markdown to HTML: Convert to HTML"
			},
			{
				"command": "markdown-to-html.openInBrowser",
				"title": "Markdown to HTML: Open in Browser"
			},
			{
				"command": "markdown-to-html.enableAutoRefresh",
				"title": "Markdown to HTML: Enable Auto-Refresh on Save"
			},
			{
				"command": "markdown-to-html.disableAutoRefresh",
				"title": "Markdown to HTML: Disable Auto-Refresh on Save"
			}
		],
		"configuration": {
			"title": "Markdown to HTML",
			"properties": {
				"markdown-to-html.outputFile": {
					"type": "string",
					"default": "index.html",
					"description": "The file path pattern to save the generated HTML to. Use <filename> as a placeholder for the original Markdown filename without extension. Defaults to index.html for untitled files or if <filename> is not used."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p tsconfig.json",
		"watch-tests": "tsc -p tsconfig.json -w",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@eslint/js": "9.24.0",
		"@technologiestiftung/semantic-release-config": "1.2.4",
		"@types/glob": "8.1.0",
		"@types/markdown-it": "13.0.7",
		"@types/mocha": "10.0.6",
		"@types/node": "18.x",
		"@types/vscode": "1.80.0",
		"@typescript-eslint/eslint-plugin": "8.29.1",
		"@typescript-eslint/parser": "8.29.1",
		"@vscode/test-electron": "2.3.9",
		"@vscode/test-cli": "0.0.10",
		"eslint": "9.24.0",
		"esbuild": "0.25.1",
		"glob": "8.1.0",
		"mocha": "10.2.0",
		"npm-run-all": "4.1.5",
		"semantic-release": "24.2.3",
		"typescript": "5.1.3",
		"typescript-eslint": "8.29.1"
	},
	"dependencies": {
		"markdown-it": "14.0.0"
	}
}
